// Command Prompt on VM ADMIN

# Install Docker
sudo apt update
sudo apt install docker.io docker-compose -y
sudo usermod -aG docker $USER
# Log out and back in

# Create docker-compose.yml
mkdir ~/guardwall-monitoring
cd ~/guardwall-monitoring
nano docker-compose.yml

version: '2'
services:
  db:
    image: influxdb:1.8
    container_name: influxdb-pfmon
    restart: always
    ports:
      - "8088:8086"
    volumes:
      - ./influxdb:/var/lib/influxdb
    environment:
      - INFLUXDB_ADMIN_USER=admin
      - INFLUXDB_ADMIN_PASSWORD=password
      - INFLUXDB_DB=pfsense
  web:
    image: grafana/grafana:latest
    container_name: pfweb
    restart: always
    ports:
      - "4000:3000"
    volumes:
      - ./grafana:/var/lib/grafana

# Start containers
docker-compose up -d

# Check InfluxDB has data
docker exec -it influxdb-pfmon influx -database pfsense -execute "SHOW MEASUREMENTS"

