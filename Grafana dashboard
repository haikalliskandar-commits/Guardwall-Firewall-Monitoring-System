11. System Load Average
sql
SELECT last("load1") AS "1 min", 
       last("load5") AS "5 min", 
       last("load15") AS "15 min" 
FROM "system" 
WHERE $timeFilter
Visualization: Stat or Gauge
Title: System Load Average

12. System Uptime
sql
SELECT last("uptime") AS "Uptime" 
FROM "system" 
WHERE $timeFilter
Visualization: Stat
Unit: seconds (or format as days)
Title: System Uptime

13. Gateway Response Time (Ping)
sql
SELECT mean("average_response_ms") AS "Ping (ms)" 
FROM "ping" 
WHERE $timeFilter 
GROUP BY time($__interval)
Visualization: Time series
Unit: ms
Title: Gateway Response Time

14. Packet Loss
sql
SELECT mean("percent_packet_loss") AS "Packet Loss %" 
FROM "ping" 
WHERE $timeFilter 
GROUP BY time($__interval)
Visualization: Time series
Unit: percent
Title: Packet Loss

15. Active IPs (Unique IPs)
sql
SELECT count(DISTINCT "value") AS "Active IPs" 
FROM "tail_filterlog" 
WHERE $timeFilter 
AND "value" =~ /.*192.168.*/
Visualization: Stat
Title: Active Network IPs

16. Top Active IPs (Bar Chart)
sql
SELECT count("value") AS "Activity", "value" AS "IP" 
FROM "tail_filterlog" 
WHERE $timeFilter 
AND "value" =~ /.*192.168.*/ 
GROUP BY "value" 
ORDER BY "Activity" DESC 
LIMIT 10
Visualization: Bar chart
Title: Top Active IPs

17. Blocked Ports (Table)
sql
SELECT "value" FROM "tail_filterlog" 
WHERE $timeFilter 
AND "value" =~ /.*block.*/ 
AND "value" =~ /.*dport.*/ 
ORDER BY time DESC 
LIMIT 20
Visualization: Table
Title: Blocked Ports

